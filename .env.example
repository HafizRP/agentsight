# AgentSight Environment Configuration

# Application Port
# Host binding port defaults to 8084 (mapped to 8080 in container)
APP_PORT=8084

# PostgreSQL Database
# Host port defaults to 5437 (NEVER bind host port 5432)
DB_PORT=5437
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5437/agentsight?sslmode=disable

# GitHub OAuth 2.0 Credentials
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Session Cookie Secret (minimum 32 characters)
SESSION_SECRET=change-this-to-a-secure-random-32-byte-secret-key

# Application Base URL (used for OAuth redirect callbacks)
BASE_URL=http://localhost:8084

# Environment (development, test, production)
APP_ENV=development

# GitHub API Token (Optional: increases rate limit from 60 to 5000 req/hr for scrapers)
GITHUB_TOKEN=

# Path to Chromium / Chrome executable for website scrapers (default: /usr/bin/chromium-browser)
CHROME_BIN=/usr/bin/chromium-browser

