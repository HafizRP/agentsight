# AgentSight Environment Configuration

# Database Credentials & Port
DB_USER=agentsight
DB_PASSWORD=agentsight
DB_NAME=agentsight
DB_PORT=5437

# Application Port
APP_PORT=8084

# Full Database Connection URL (used by local go run or direct backend connections)
DATABASE_URL=postgres://agentsight:agentsight@127.0.0.1:5437/agentsight?sslmode=disable

# Session Secret (used for cookie encryption, min 32 chars in production)
SESSION_SECRET=change-this-to-a-secure-random-32-byte-secret-key

# Application Base URL (for OAuth redirect callbacks)
BASE_URL=http://localhost:8084

# Environment (development, test, production)
APP_ENV=development

# GitHub API Token (Optional: increases rate limit from 60 to 5000 req/hr for scrapers)
GITHUB_TOKEN=

# GitHub OAuth 2.0 Credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Path to Chromium / Chrome executable for website scrapers
CHROME_BIN=/usr/bin/chromium-browser
