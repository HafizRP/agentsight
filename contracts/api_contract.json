{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "AgentSight API Contract",
  "version": "1.0.0",
  "description": "REST API and Web route specifications for AgentSight AI Agent Skill Discovery Engine",
  "base_url": "http://localhost:8080",
  "authentication": {
    "type": "cookie",
    "cookie_name": "agentsight_session",
    "header_fallback": "Authorization: Bearer <token>",
    "oauth_provider": "github"
  },
  "endpoints": [
    {
      "path": "/healthz",
      "method": "GET",
      "description": "Liveness probe verifying HTTP service availability",
      "auth_required": false,
      "responses": {
        "200": {
          "description": "Service is live",
          "content_type": "application/json",
          "schema": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "example": "ok" }
            },
            "required": ["status"]
          }
        }
      }
    },
    {
      "path": "/readyz",
      "method": "GET",
      "description": "Readiness probe verifying PostgreSQL database connectivity",
      "auth_required": false,
      "responses": {
        "200": {
          "description": "Database pool healthy",
          "content_type": "application/json",
          "schema": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "example": "ready" },
              "database": { "type": "string", "example": "connected" }
            },
            "required": ["status", "database"]
          }
        },
        "503": {
          "description": "Database disconnected or unready",
          "content_type": "application/json",
          "schema": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "example": "not ready" },
              "error": { "type": "string" }
            },
            "required": ["status", "error"]
          }
        }
      }
    },
    {
      "path": "/",
      "method": "GET",
      "description": "Landing page displaying top trending skills and ecosystem metrics",
      "auth_required": false,
      "responses": {
        "200": {
          "content_type": "text/html",
          "description": "Discovery landing view"
        }
      }
    },
    {
      "path": "/search",
      "method": "GET",
      "description": "Search results HTML page with keyword and category filters",
      "auth_required": false,
      "parameters": [
        { "name": "q", "in": "query", "type": "string", "description": "Search term" },
        { "name": "platform", "in": "query", "type": "string", "enum": ["cursor", "claude", "gemini", "mcp", "copilot", "generic"] },
        { "name": "category", "in": "query", "type": "string", "enum": ["rules", "skills", "mcp_servers", "prompts", "frameworks", "tools"] },
        { "name": "page", "in": "query", "type": "integer", "default": 1 }
      ],
      "responses": {
        "200": {
          "content_type": "text/html",
          "description": "Search page HTML"
        }
      }
    },
    {
      "path": "/skill/{slug}",
      "method": "GET",
      "description": "Skill detail view including install snippet and raw configuration",
      "auth_required": false,
      "parameters": [
        { "name": "slug", "in": "path", "type": "string", "required": true }
      ],
      "responses": {
        "200": {
          "content_type": "text/html",
          "description": "Skill detail HTML view"
        },
        "404": {
          "content_type": "application/json",
          "schema": {
            "type": "object",
            "properties": { "error": { "type": "string" } }
          }
        }
      }
    },
    {
      "path": "/trending",
      "method": "GET",
      "description": "Trending leaderboard HTML view ranked by star velocity",
      "auth_required": false,
      "responses": {
        "200": {
          "content_type": "text/html",
          "description": "Trending skills leaderboard"
        }
      }
    },
    {
      "path": "/category/{category}",
      "method": "GET",
      "description": "Browse skills filtered by category",
      "auth_required": false,
      "parameters": [
        { "name": "category", "in": "path", "type": "string", "required": true }
      ],
      "responses": {
        "200": { "content_type": "text/html" }
      }
    },
    {
      "path": "/platform/{platform}",
      "method": "GET",
      "description": "Browse skills filtered by platform",
      "auth_required": false,
      "parameters": [
        { "name": "platform", "in": "path", "type": "string", "required": true }
      ],
      "responses": {
        "200": { "content_type": "text/html" }
      }
    },
    {
      "path": "/api/v1/skills",
      "method": "GET",
      "description": "Paginated list of indexed skills with multiple filter options",
      "auth_required": false,
      "parameters": [
        { "name": "platform", "in": "query", "type": "string" },
        { "name": "category", "in": "query", "type": "string" },
        { "name": "subcategory", "in": "query", "type": "string" },
        { "name": "language", "in": "query", "type": "string" },
        { "name": "tag", "in": "query", "type": "string" },
        { "name": "sort", "in": "query", "type": "string", "enum": ["stars", "newest", "trending", "relevance"] },
        { "name": "page", "in": "query", "type": "integer", "default": 1 },
        { "name": "limit", "in": "query", "type": "integer", "default": 20 }
      ],
      "responses": {
        "200": {
          "content_type": "application/json",
          "schema": {
            "type": "object",
            "properties": {
              "skills": { "type": "array", "items": { "$ref": "#/definitions/Skill" } },
              "total": { "type": "integer" },
              "page": { "type": "integer" },
              "limit": { "type": "integer" },
              "total_pages": { "type": "integer" }
            }
          }
        }
      }
    },
    {
      "path": "/api/v1/skills/{slug}",
      "method": "GET",
      "description": "Get detailed skill metadata including bookmark status and related skills",
      "auth_required": false,
      "parameters": [
        { "name": "slug", "in": "path", "type": "string", "required": true }
      ],
      "responses": {
        "200": {
          "content_type": "application/json",
          "schema": {
            "type": "object",
            "properties": {
              "skill": { "$ref": "#/definitions/Skill" },
              "is_bookmarked": { "type": "boolean" },
              "related_skills": { "type": "array", "items": { "$ref": "#/definitions/Skill" } }
            },
            "required": ["skill", "is_bookmarked", "related_skills"]
          }
        },
        "404": {
          "content_type": "application/json",
          "schema": {
            "type": "object",
            "properties": { "error": { "type": "string" } }
          }
        }
      }
    },
    {
      "path": "/api/v1/search",
      "method": "GET",
      "description": "Full-text search across skill name, description, tags, and raw content",
      "auth_required": false,
      "parameters": [
        { "name": "q", "in": "query", "type": "string" },
        { "name": "platform", "in": "query", "type": "string" },
        { "name": "category", "in": "query", "type": "string" },
        { "name": "subcategory", "in": "query", "type": "string" },
        { "name": "language", "in": "query", "type": "string" },
        { "name": "tag", "in": "query", "type": "string" },
        { "name": "sort", "in": "query", "type": "string" },
        { "name": "page", "in": "query", "type": "integer", "default": 1 },
        { "name": "limit", "in": "query", "type": "integer", "default": 20 }
      ],
      "responses": {
        "200": {
          "content_type": "application/json",
          "schema": {
            "type": "object",
            "properties": {
              "skills": { "type": "array", "items": { "$ref": "#/definitions/Skill" } },
              "total": { "type": "integer" },
              "page": { "type": "integer" },
              "limit": { "type": "integer" },
              "total_pages": { "type": "integer" },
              "query": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "path": "/api/v1/trending",
      "method": "GET",
      "description": "Top skills ranked by star gain velocity over the last 7 days",
      "auth_required": false,
      "parameters": [
        { "name": "limit", "in": "query", "type": "integer", "default": 10 }
      ],
      "responses": {
        "200": {
          "content_type": "application/json",
          "schema": {
            "type": "object",
            "properties": {
              "skills": { "type": "array", "items": { "$ref": "#/definitions/Skill" } },
              "total": { "type": "integer" }
            }
          }
        }
      }
    },
    {
      "path": "/api/v1/bookmarks/{skill_id}",
      "method": "POST",
      "description": "Toggle bookmark state for a skill (active session required)",
      "auth_required": true,
      "parameters": [
        { "name": "skill_id", "in": "path", "type": "integer", "required": true }
      ],
      "responses": {
        "200": {
          "content_type": "application/json",
          "schema": {
            "type": "object",
            "properties": {
              "skill_id": { "type": "integer" },
              "bookmarked": { "type": "boolean" }
            },
            "required": ["skill_id", "bookmarked"]
          }
        },
        "401": {
          "content_type": "application/json",
          "schema": {
            "type": "object",
            "properties": { "error": { "type": "string" } }
          }
        }
      }
    },
    {
      "path": "/api/v1/bookmarks",
      "method": "GET",
      "description": "List all skills bookmarked by the authenticated user",
      "auth_required": true,
      "parameters": [
        { "name": "page", "in": "query", "type": "integer", "default": 1 },
        { "name": "limit", "in": "query", "type": "integer", "default": 20 }
      ],
      "responses": {
        "200": {
          "content_type": "application/json",
          "schema": {
            "type": "object",
            "properties": {
              "skills": { "type": "array", "items": { "$ref": "#/definitions/Skill" } },
              "total": { "type": "integer" },
              "page": { "type": "integer" },
              "limit": { "type": "integer" },
              "total_pages": { "type": "integer" }
            }
          }
        },
        "401": {
          "content_type": "application/json",
          "schema": {
            "type": "object",
            "properties": { "error": { "type": "string" } }
          }
        }
      }
    },
    {
      "path": "/api/v1/stats",
      "method": "GET",
      "description": "Aggregated platform and category counts across the indexed catalog",
      "auth_required": false,
      "responses": {
        "200": {
          "content_type": "application/json",
          "schema": {
            "type": "object",
            "properties": {
              "total_skills": { "type": "integer" },
              "total_stars": { "type": "integer" },
              "total_sources": { "type": "integer" },
              "platform_counts": { "type": "object", "additionalProperties": { "type": "integer" } },
              "category_counts": { "type": "object", "additionalProperties": { "type": "integer" } }
            }
          }
        }
      }
    },
    {
      "path": "/auth/github",
      "method": "GET",
      "description": "Initiate GitHub OAuth 2.0 authentication redirect",
      "auth_required": false,
      "responses": {
        "307": {
          "description": "Temporary redirect to GitHub OAuth endpoint"
        }
      }
    },
    {
      "path": "/auth/github/callback",
      "method": "GET",
      "description": "Handle GitHub OAuth callback, create/sync user, and set session cookie",
      "auth_required": false,
      "parameters": [
        { "name": "code", "in": "query", "type": "string", "required": true },
        { "name": "state", "in": "query", "type": "string", "required": true }
      ],
      "responses": {
        "303": {
          "description": "Redirects to home page on success with Set-Cookie: agentsight_session=<token>"
        },
        "400": { "content_type": "application/json" },
        "500": { "content_type": "application/json" }
      }
    },
    {
      "path": "/auth/logout",
      "method": "POST",
      "description": "Invalidate current session and clear session cookie",
      "auth_required": false,
      "responses": {
        "200": {
          "content_type": "application/json",
          "schema": {
            "type": "object",
            "properties": { "status": { "type": "string", "example": "logged out" } }
          }
        },
        "303": {
          "description": "Redirects to / when called from HTML form"
        }
      }
    }
  ],
  "definitions": {
    "Skill": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "platform": { "type": "string", "enum": ["cursor", "claude", "gemini", "mcp", "copilot", "generic"] },
        "category": { "type": "string", "enum": ["rules", "skills", "mcp_servers", "prompts", "frameworks", "tools"] },
        "subcategory": { "type": "string" },
        "source_url": { "type": "string" },
        "repo_url": { "type": "string" },
        "repo_owner": { "type": "string" },
        "repo_name": { "type": "string" },
        "stars_count": { "type": "integer" },
        "forks_count": { "type": "integer" },
        "stars_velocity": { "type": "integer" },
        "content_raw": { "type": "string" },
        "content_preview": { "type": "string" },
        "install_snippet": { "type": "string" },
        "file_path": { "type": "string" },
        "language": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "last_synced_at": { "type": "string", "format": "date-time" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "slug", "platform", "category", "source_url"]
    }
  }
}
